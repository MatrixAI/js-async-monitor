{
  "name": "@matrixai/async-monitor",
  "version": "0.0.2",
  "author": "Roger Qiu",
  "description": "Asynchronous monitor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-async-monitor.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "ts-node": "ts-node",
    "test": "jest",
    "lint": "matrixai-lint",
    "lintfix": "matrixai-lint --fix",
    "docs": "shx rm -rf ./docs && typedoc --gitRevision master --tsconfig ./tsconfig.build.json --out ./docs src"
  },
  "dependencies": {
    "@matrixai/async-locks": "^3.2.0"
  },
  "devDependencies": {
    "@matrixai/lint": "^0.2.4",
    "@swc/core": "^1.3.62",
    "@swc/jest": "^0.2.26",
    "@types/jest": "^28.1.3",
    "@types/node": "^18.15.0",
    "jest": "^28.1.1",
    "jest-extended": "^3.0.1",
    "jest-junit": "^14.0.0",
    "shx": "^0.3.4",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^3.9.0",
    "typedoc": "^0.23.21",
    "typescript": "^4.9.3"
  }
}
